<div class="container" id="container">
  <div class="monitor" id="monitor"></div>
  <div class="keyboard" aria-hidden="true"></div>
  <div class="title absolute" id="title" lang="en">Hi! I'm Yutteee!</div>
  <div class="scroll" id="scroll">Scroll</div>
</div>
<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  const monitor = document.getElementById("monitor");
  const container = document.getElementById("container");
  const title = document.getElementById("title");

  // アニメーションのタイムラインを作成
  const tl = gsap.timeline({
    scrollTrigger: {
      trigger: container,
      start: "top top",
      end: "bottom top",
      scrub: 1,
      // markers: true,
      toggleActions: "play none none none",
    },
  });

  // タイムラインにアニメーションを追加
  tl.to(monitor, {
    borderRadius: "0",
    width: "100%",
    height: "100vh",
  }).to(
    title,
    {
      opacity: 0,
    },
    "<"
  ); // 同時に実行

  // アニメーション停止の制御を追加
  const updateAnimation = () => {
    const isStop = document.documentElement.classList.contains("stop");
    if (isStop) {
      tl.scrollTrigger?.disable();
    } else {
      tl.scrollTrigger?.enable();
    }
  };

  // 初期状態の設定
  updateAnimation();

  // <html> の `.stop` クラス変化を監視して GSAP の有効/無効を切り替え
  const observer = new MutationObserver(updateAnimation);
  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
</script>

<style>
  .container {
    --hero-monitor-width: min(
      calc(max(180px, 20vh) * var(--computer-aspect-ratio)),
      calc(100vw - var(--space-s) * 2)
    );
    --hero-monitor-height: calc(var(--hero-monitor-width) / var(--computer-aspect-ratio));
    height: 100vh;
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: var(--color-accent);
    position: relative;
  }

  .monitor {
    aspect-ratio: var(--computer-aspect-ratio);
    width: var(--hero-monitor-width);
    height: var(--hero-monitor-height);
    background-color: var(--color-background);
    border-radius: var(--radius-xl);
    border: var(--border-width-xl) solid var(--color-background);
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 1;
  }

  .keyboard {
    width: calc(var(--hero-monitor-width) * var(--computer-keyboard-width-ratio));
    height: calc(var(--hero-monitor-width) * var(--computer-keyboard-depth-ratio));
    background-color: var(--color-background);
    clip-path: polygon(
      var(--border-width-xl) 0,
      calc(100% - var(--border-width-xl)) 0,
      100% 100%,
      0 100%
    );
    position: fixed;
    top: calc(50% + var(--hero-monitor-height) / 2 + var(--hero-monitor-width) * var(--computer-gap-ratio));
    left: 50%;
    transform: translateX(-50%);
  }

  .absolute {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 100%;
    display: flex;
    justify-content: center;
    z-index: 2;
  }

  .title {
    font-size: var(--step-6);
    font-weight: 900;
    margin-bottom: var(--space-xl);
  }

  .scroll {
    position: fixed;
    bottom: 10%;
    left: 50%;
    transform: translateX(-50%);
    letter-spacing: 0.1rem;

    &::after {
      content: "";
      position: absolute;
      top: 1.8rem;
      left: 50%;
      translate: -50% 0;
      transform-origin: top;
      width: var(--space-4xs);
      height: 36px;
      background: var(--color-border);
      animation: pathmove 1.5s ease-in-out infinite;
      opacity: 1;
    }
  }
  @keyframes pathmove {
    0% {
      translate: -50% 0;
      scale: 1 calc(20 / 36);
      opacity: 0;
    }
    30% {
      scale: 1 1;
      opacity: 1;
    }
    100% {
      translate: -50% 30px;
      scale: 1 calc(20 / 36);
      opacity: 0;
    }
  }

  :global(.stop) .scroll::after {
    animation-play-state: paused;
  }

</style>
